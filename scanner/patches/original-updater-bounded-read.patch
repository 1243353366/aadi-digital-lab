-def _fetch(url, timeout=30):
+def _fetch(url, timeout=30, max_bytes=MAX_IOC_DOWNLOAD):
     """Fetch a URL over HTTPS with certificate verification on. Returns bytes."""
     if not url.lower().startswith("https://"):
         raise SystemExit("refusing to fetch over a non-HTTPS URL: {}".format(url))
     ctx = ssl.create_default_context()  # verifies the certificate chain + hostname
     req = urllib.request.Request(url, headers={"User-Agent": "adint-scan-update"})
     with urllib.request.urlopen(req, timeout=timeout, context=ctx) as resp:
-        return resp.read()
+        encoding = resp.headers.get("Content-Encoding")
+        if encoding and encoding.strip().lower() != "identity":
+            raise ValueError("refusing compressed download: {}".format(encoding))
+        advertised_length = resp.headers.get("Content-Length")
+        if advertised_length is not None:
+            try:
+                advertised_length = int(advertised_length)
+            except (TypeError, ValueError):
+                raise ValueError("invalid Content-Length: {}"
+                                 .format(advertised_length))
+            if advertised_length < 0:
+                raise ValueError("negative Content-Length: {}"
+                                 .format(advertised_length))
+            if advertised_length > max_bytes:
+                raise ValueError("download exceeds {} byte limit".format(max_bytes))
+        data = bytearray()
+        while True:
+            remaining = max_bytes + 1 - len(data)
+            chunk = resp.read(min(DOWNLOAD_CHUNK_SIZE, remaining))
+            if not chunk:
+                return bytes(data)
+            if len(chunk) > remaining:
+                raise ValueError("download exceeds {} byte limit".format(max_bytes))
+            data.extend(chunk)
+            if len(data) > max_bytes:
+                raise ValueError("download exceeds {} byte limit".format(max_bytes))


